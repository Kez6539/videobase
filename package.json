{
  "name": "videobase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An editorial workbench for business adverts, with review before generation.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=./",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "vb": "tsx src/cli.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
